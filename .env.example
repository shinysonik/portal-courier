@"
# Vultr Serverless Inference
VULTR_API_KEY=your_key_here
VULTR_BASE_URL=https://api.vultr.com/v2
VULTR_MODEL=your_model_name

# Proxy
PROXY_PORT=8080

# Demo portals
GOOD_PORTAL_URL=http://localhost:5001
HOSTILE_PORTAL_URL=http://localhost:5002

# Demo portal credentials (defaults; change only if you know why)
REAL_USERNAME=anna
REAL_PASSWORD=real_secret_123
REAL_NIP=9876543210
"@ | Set-Content -Encoding ASCII .env.example