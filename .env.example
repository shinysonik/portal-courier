# --- Vultr Serverless Inference (key from Products > Serverless > Inference; NOT the cloud API key)
VULTR_API_KEY=VHKC4JU56X5IS3ERDT7NRBOAMGDYZ5JHPOHQ
VULTR_BASE_URL=https://api.vultrinference.com/v1
VULTR_MODEL=your_instruct_model_id

# --- Orchestrator
RUNNER=docker
# Docker Desktop (Windows/Mac dev):  PROXY_URL=http://host.docker.internal:8888
# Linux VM with zero-trust network:  PROXY_URL=http://172.28.0.1:8888  and  DOCKER_NETWORK=playwright-net
PROXY_URL=http://host.docker.internal:8888
DOCKER_NETWORK=

# NOTE: the demo portals' real credentials (REAL_USERNAME / REAL_PASSWORD, defaults in proxy/addon.py) must be set
# only in the shell that starts mitmdump - never in this file, because the orchestrator loads .env.
